# GE ESPORTS Environment Configuration
PORT=5000
NODE_ENV=production

# Staff Admin Security (Backend-only PIN and Session Secret)
ADMIN_PIN=your-secret-staff-pin
SESSION_SECRET=your-random-32-byte-hex-session-secret

# Email Dispatch Configuration (Official Grenite Esports Mailboxes)
SENDER_EMAIL=grenite07@gmail.com
ADMIN_EMAIL=grenite07@gmail.com

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=grenite07@gmail.com
# 16-character Google App Password (generate at myaccount.google.com/apppasswords)
SMTP_PASS=your-google-app-password

# Production Frontend URL for CORS (set in Render: e.g. https://ge-esports.vercel.app)
FRONTEND_URL=

# Production Backend API URL (set in Vercel: e.g. https://ge-esports-api.onrender.com)
# Leave blank for local development to use the Vite proxy
VITE_API_URL=
